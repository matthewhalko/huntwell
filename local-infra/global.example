# ── local-infra/global ───────────────────────────────────────────────────────
#
# The settings the server and every run read at startup. start.sh writes the
# database URL and ports into this file each time it brings the cluster up and
# preserves everything else, so put your own keys below the marker.
#
# Resolution order everywhere: process environment → this file. A value in
# the environment always wins, so a one-off override never needs an edit.
#
# This file is gitignored — it holds live credentials.
#
# In production it holds only KEY and SECRET — the AWS credential that opens
# the Huntwell_Production secret — and is encrypted exactly as Park River's is
# (openssl enc with genesis_prod, which ./build.sh compiles into the binary). Everything else comes from that secret or the setting table
# (`admin config set`). See docs/SECRETS.md. A dev checkout leaves it plain.
#
#KEY=AKIA...
#SECRET=...

# ── written by start.sh ──────────────────────────────────────────────────────
HUNTWELL_DATABASE_URL=postgres://postgres@127.0.0.1:6511/huntwell
HUNTWELL_ADDR=127.0.0.1:8611
HUNTWELL_INSTANCE=default
HUNTWELL_CDP_PORT_BASE=20611
HUNTWELL_DATA_DIR=/abs/path/local-infra/data/huntwell

# ── yours ────────────────────────────────────────────────────────────────────

# The Cursor agent key the runner drives scrapes with. Required for runs and
# the AI plan wizard; the rest of the app works without it.
#CURSOR_API_KEY=...

# Secret the session cookies are signed with. Generated once by start.sh if
# absent; rotate it to sign everyone out.
#HUNTWELL_SESSION_SECRET=...

# Set to 1 to let anyone sign up. Default: open. Set to 0 to require an
# existing account to create others (`huntwell account create`).
#HUNTWELL_OPEN_SIGNUP=1

# ── Identity ─────────────────────────────────────────────────────────────────
#
# Where passwords live. Unset: a configured Cognito pool means `cognito`, no
# pool means `local` (argon2 in the account row) — so a dev box needs no AWS.
# Production is `cognito`, and those rows store no hash at all.
#HUNTWELL_IDENTITY=local
#
# The pool. Production reads these from Secrets Manager; here is for pointing a
# dev box at a real pool. The app client needs ALLOW_USER_PASSWORD_AUTH.
#COGNITO_USER_POOL_ID=us-east-1_AbC123
#COGNITO_CLIENT_ID=...
#COGNITO_CLIENT_SECRET=...
#COGNITO_REGION=us-east-1
# An IAM user allowed AdminCreateUser / AdminSetUserPassword / AdminDeleteUser
# on that pool and nothing else — never the bootstrap key.
#AWS_COGNITO_KEY=AKIA...
#AWS_COGNITO_SECRET=...

# Chrome display mode for runs: headed | xvfb | headless. Omit to detect.
#HUNTWELL_CHROME_DISPLAY=headless

# Browser backend. If the two keys below are set, runs use Browserbase (so
# Watch the browser works). Force the laptop Chrome with HUNTWELL_BROWSER=local.
# HUNTWELL_BROWSER=browserbase without the keys fails a run rather than
# falling through to Chrome.
#HUNTWELL_BROWSER=browserbase
#BROWSERBASE_API_KEY=bb_...
#BROWSERBASE_PROJECT_ID=...
# Optional: residential proxies, a region, and a persistent Context (the cloud
# equivalent of a per-account Chrome profile, so logins survive between runs).
#BROWSERBASE_PROXIES=1
#BROWSERBASE_REGION=us-east-1
#BROWSERBASE_CONTEXT_ID=...

# Full path to the browser binary, if not on PATH or in a standard location.
#HUNTWELL_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ── Admin control plane ──────────────────────────────────────────────────────
#
# Only the admin reads these (`admin`, or `huntwell admin` in dev). It manages bare-metal Incus hosts,
# provisions the application's VMs on them, and assigns queued executions to
# worker slots. In production they come from Secrets Manager.
#
# Its own login — not a product Account. Seeded (and reset) at every start.
#HUNTWELL_ADMIN_EMAIL=ops@example.com
#HUNTWELL_ADMIN_PASSWORD=...
#HUNTWELL_ADMIN_ADDR=127.0.0.1:8710
#
# The database URL AS THE VMs REACH IT. Worker slots claim their work from the
# database — that is the only path a run takes to a worker — so when the admin's
# own HUNTWELL_DATABASE_URL is loopback, this must be an address the VMs can
# dial, or every slot starts and then sits retrying.
#HUNTWELL_POOL_DATABASE_URL=postgres://huntwell:...@10.0.0.2:5432/huntwell
#
# Where Deploy takes executables from: bin/ubuntu (x86_64) or bin/ubuntu-arm64
# (aarch64) as ./build.sh writes them. Default: build/ beside the admin binary.
#HUNTWELL_BUILD_DIR=/opt/huntwell/build
#
# This admin's Incus client certificate and the hosts it trusts. A credential:
# whoever holds it can drive every host. Default: under the data directory.
#HUNTWELL_INCUS_CONF=/opt/huntwell/incus
#
# Dev only: run worker slots as child processes of the admin, no VMs.
#HUNTWELL_LOCAL_POOL=2

# ── Settings the app VM is given ─────────────────────────────────────────────
#
# The admin writes these into the app VM's settings file. A worker VM never
# receives them: a compromised worker must not hold the identity pool, mail,
# billing or the session secret.
#
# Where the app lives, for the links in verification email.
#HUNTWELL_PUBLIC_URL=https://app.example.com
#
# Outbound mail. Without it, verification email is written to the log instead
# of sent, and nobody can confirm an account.
#HUNTWELL_MAIL_FROM=Huntwell <hello@example.com>
#
# Signups on the deployed app. Default 0: anyone who finds the URL would
# otherwise get an account and start spending your agent tokens.
#HUNTWELL_OPEN_SIGNUP=0

# ── Object storage, for every VM ─────────────────────────────────────────────
#
# For `assets` runs. A worker VM writes the bytes and the app VM serves them
# later, so both need the same store — a directory inside one VM is not one.
#HUNTWELL_S3_ENDPOINT=https://s3.example.com
#HUNTWELL_S3_BUCKET=huntwell
#HUNTWELL_S3_ACCESS_KEY=...
#HUNTWELL_S3_SECRET_KEY=...
# The same store AS THE VMs REACH IT, when that differs from the admin's own
# view — the object-store twin of HUNTWELL_POOL_DATABASE_URL.
#HUNTWELL_POOL_S3_ENDPOINT=http://minio.internal:9000

# ── NOT here ─────────────────────────────────────────────────────────────────
#
# Environment only (never read from this file):
#   HUNTWELL_DEV — turns on the Vite dev proxy hints and relaxed cookies
#
# Per-run only (set by the server when it spawns a run, never by hand):
#   HUNTWELL_RUN_ID, HUNTWELL_CDP_PORT, HUNTWELL_CHROME_DIR,
#   HUNTWELL_AGENT_WORKSPACE, HUNTWELL_NAV_ALLOWLIST
