{
  "manifest_version": 3,
  "name": "Huntwell for Chrome",
  "short_name": "Huntwell",
  "version": "0.1.0",
  "description": "Send your Huntwell outreach on LinkedIn and Reddit. Huntwell fills the message in — you press Send.",
  "key": "",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Open Huntwell", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "identity", "storage", "tabs"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.reddit.com/*",
    "https://huntwell.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    { "matches": ["https://www.linkedin.com/*"], "js": ["content/common.js", "content/linkedin.js"], "run_at": "document_idle" },
    { "matches": ["https://www.reddit.com/*"], "js": ["content/common.js", "content/reddit.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/*.woff2"], "matches": ["https://www.linkedin.com/*", "https://www.reddit.com/*"] }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
