# Copy to secrets.env (gitignored) and fill in. Every value becomes a key in the
# huntwell-secrets Secret, which every pod reads through envFrom.
#
# Generate the two passwords, do not invent them:
#   openssl rand -hex 24
#
# POSTGRES_PASSWORD must match the password inside HUNTWELL_DATABASE_URL.
POSTGRES_PASSWORD=
HUNTWELL_DATABASE_URL=postgres://huntwell:THE_SAME_PASSWORD@postgres:5432/huntwell

# Signs session cookies. Changing it signs everyone out; losing it is fine.
HUNTWELL_SESSION_SECRET=

# The agent. Runs and plan drafting both fail without it.
CURSOR_API_KEY=

# The remote browser runs collect through.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Object storage. Any pair you like — they are MinIO's admin credentials and
# the application's S3 key at the same time.
HUNTWELL_S3_ACCESS_KEY=huntwell
HUNTWELL_S3_SECRET_KEY=

# Outbound mail. Without these, verification emails are written to the log
# instead of sent, which means nobody can confirm an account.
HUNTWELL_MAIL_API_KEY=
HUNTWELL_MAIL_FROM=Huntwell <hello@yourdomain.com>

# From the Cloudflare dashboard when you create the tunnel. This is how the
# outside world reaches the cluster.
CLOUDFLARE_TUNNEL_TOKEN=

# Not set on purpose. The admin mints a setup key at first boot and prints it;
# you claim the console with that. Setting these two instead would put the first
# operator password in this file, in a Secret, and in your shell history.
# HUNTWELL_ADMIN_EMAIL=
# HUNTWELL_ADMIN_PASSWORD=
