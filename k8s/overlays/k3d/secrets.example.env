# Copy to secrets.env (gitignored) — or let k3d/up.sh generate it from
# local-infra/global. Every value here becomes a key in the huntwell-secrets
# Secret, which every pod reads through envFrom.
#
# One database. The auth/core pair is gone: it existed when auth was its own
# service, and the website now serves auth and everything else in one process.
POSTGRES_PASSWORD=change-me
HUNTWELL_DATABASE_URL=postgres://huntwell:change-me@postgres:5432/huntwell
HUNTWELL_SESSION_SECRET=change-me-to-a-long-random-string
CURSOR_API_KEY=crsr_...
BROWSERBASE_API_KEY=bb_live_...
BROWSERBASE_PROJECT_ID=00000000-0000-0000-0000-000000000000
# The operator login for the admin service. Seeded on its first start.
HUNTWELL_ADMIN_EMAIL=you@example.com
HUNTWELL_ADMIN_PASSWORD=change-me
